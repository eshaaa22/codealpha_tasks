<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Responsive Image Gallery</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        .animate-fade-in {
            animation: fadeIn 0.3s ease-in-out;
        }
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen selection:bg-indigo-500 selection:text-white">

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="text-center mb-12">
            <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
                Discover <span class="text-indigo-600">Moments</span>
            </h1>
            <p class="text-lg text-slate-500 max-w-2xl mx-auto">
                Explore our curated collection of stunning photography. Filter by category or click on an image to view it in full resolution.
            </p>
        </div>

        <div class="flex flex-wrap justify-center gap-3 mb-10" id="filter-container">
            <button class="filter-btn active px-6 py-2 rounded-full bg-indigo-600 text-white font-medium shadow-md shadow-indigo-200 transition-all hover:bg-indigo-700" data-category="All">All</button>
            <button class="filter-btn px-6 py-2 rounded-full bg-white text-slate-600 font-medium shadow-sm border border-slate-200 transition-all hover:bg-slate-50" data-category="Nature">Nature</button>
            <button class="filter-btn px-6 py-2 rounded-full bg-white text-slate-600 font-medium shadow-sm border border-slate-200 transition-all hover:bg-slate-50" data-category="City">City</button>
            <button class="filter-btn px-6 py-2 rounded-full bg-white text-slate-600 font-medium shadow-sm border border-slate-200 transition-all hover:bg-slate-50" data-category="Animals">Animals</button>
        </div>

        <div id="gallery" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6"></div>
    </div>

    <div id="lightbox" class="fixed inset-0 z-50 hidden bg-slate-900/95 backdrop-blur-sm flex items-center justify-center animate-fade-in opacity-0 transition-opacity duration-300">
        <button id="lightbox-close" class="absolute top-6 right-6 text-white/70 hover:text-white p-2 transition-colors z-50">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>

        <button id="lightbox-prev" class="absolute left-4 md:left-10 top-1/2 -translate-y-1/2 text-white/70 hover:text-white p-3 rounded-full hover:bg-white/10 transition-all z-50">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
        </button>

        <div class="relative max-w-5xl w-full max-h-[85vh] px-4 flex flex-col items-center justify-center">
            <img id="lightbox-img" src="" alt="Enlarged view" class="max-w-full max-h-[80vh] object-contain rounded-lg shadow-2xl transition-transform duration-300">
            <div id="lightbox-caption" class="text-white mt-4 text-lg font-medium tracking-wide"></div>
        </div>

        <button id="lightbox-next" class="absolute right-4 md:right-10 top-1/2 -translate-y-1/2 text-white/70 hover:text-white p-3 rounded-full hover:bg-white/10 transition-all z-50">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
        </button>
    </div>

    <script>
        const galleryData = [
            { id: 1, src: 'https://images.unsplash.com/photo-1472214103451-9374bd1c798e?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80', category: 'Nature', title: 'Misty Mountains' },
            { id: 2, src: 'https://images.unsplash.com/photo-1477959858617-67f85cf4f1df?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80', category: 'City', title: 'Chicago Skyline' },
            { id: 3, src: 'https://images.unsplash.com/photo-1546182990-dffeafbe841d?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80', category: 'Animals', title: 'Lion Portrait' },
            { id: 4, src: 'https://images.unsplash.com/photo-1469474968028-56623f02e42e?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80', category: 'Nature', title: 'Serene Lake' },
            { id: 5, src: 'https://images.unsplash.com/photo-1514539079130-25950c84af65?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80', category: 'City', title: 'London Nights' },
            { id: 6, src: 'https://images.unsplash.com/photo-1564349683136-77e08dba1ef7?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80', category: 'Animals', title: 'Panda Eating' },
            { id: 7, src: 'https://images.unsplash.com/photo-1426604966848-d7adac402bff?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80', category: 'Nature', title: 'Forest Trail' },
            { id: 8, src: 'https://images.unsplash.com/photo-1480714378408-67cf0d13bc1b?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80', category: 'City', title: 'New York Streets' },
            { id: 9, src: 'https://images.unsplash.com/photo-1507146153580-69a1fe6d8aa1?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80', category: 'Animals', title: 'Wolf Pack' },
            { id: 10, src: 'https://images.unsplash.com/photo-1518182170546-076616fd4aa8?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80', category: 'Nature', title: 'Autumn Leaves' },
            { id: 11, src: 'https://images.unsplash.com/photo-1519501025264-65ba15a82390?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80', category: 'City', title: 'Tokyo Neon' },
            { id: 12, src: 'https://images.unsplash.com/photo-1534567153574-2b12153a87f0?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80', category: 'Animals', title: 'Cheetah Stare' }
        ];

        let currentFilter = 'All';
        let filteredImages = [...galleryData];
        let currentLightboxIndex = 0;

        const galleryContainer = document.getElementById('gallery');
        const filterButtons = document.querySelectorAll('.filter-btn');
        const lightbox = document.getElementById('lightbox');
        const lightboxImg = document.getElementById('lightbox-img');
        const lightboxCaption = document.getElementById('lightbox-caption');
        const btnClose = document.getElementById('lightbox-close');
        const btnNext = document.getElementById('lightbox-next');
        const btnPrev = document.getElementById('lightbox-prev');

        function renderGallery() {
            galleryContainer.innerHTML = '';
            
            if (filteredImages.length === 0) {
                galleryContainer.innerHTML = '<p class="col-span-full text-center text-slate-500 py-10">No images found for this category.</p>';
                return;
            }

            filteredImages.forEach((image, index) => {
                const item = document.createElement('div');
                item.className = 'group relative overflow-hidden rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 cursor-pointer bg-white aspect-square sm:aspect-[4/3]';
                item.onclick = () => openLightbox(index);

                const img = document.createElement('img');
                img.src = image.src;
                img.alt = image.title;
                img.loading = 'lazy';
                img.className = 'w-full h-full object-cover transition-transform duration-500 group-hover:scale-110';
                img.onerror = function() {
                    this.src = 'https://placehold.co/800x600/e2e8f0/475569?text=Image+Unavailable';
                };

                const overlay = document.createElement('div');
                overlay.className = 'absolute inset-0 bg-gradient-to-t from-slate-900/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6';
                
                const title = document.createElement('h3');
                title.className = 'text-white font-semibold text-lg translate-y-4 group-hover:translate-y-0 transition-transform duration-300';
                title.textContent = image.title;

                overlay.appendChild(title);
                item.appendChild(img);
                item.appendChild(overlay);
                galleryContainer.appendChild(item);
            });
        }

        function handleFilterClick(e) {
            const selectedCategory = e.target.getAttribute('data-category');
            
            filterButtons.forEach(btn => {
                if (btn.getAttribute('data-category') === selectedCategory) {
                    btn.className = 'filter-btn active px-6 py-2 rounded-full bg-indigo-600 text-white font-medium shadow-md shadow-indigo-200 transition-all hover:bg-indigo-700';
                } else {
                    btn.className = 'filter-btn px-6 py-2 rounded-full bg-white text-slate-600 font-medium shadow-sm border border-slate-200 transition-all hover:bg-slate-50';
                }
            });

            filteredImages = selectedCategory === 'All' 
                ? [...galleryData] 
                : galleryData.filter(img => img.category === selectedCategory);

            renderGallery();
        }

        function openLightbox(index) {
            currentLightboxIndex = index;
            updateLightboxContent();
            
            lightbox.classList.remove('hidden');
            setTimeout(() => {
                lightbox.classList.remove('opacity-0');
                lightbox.classList.add('opacity-100');
            }, 10);
            
            document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
            lightbox.classList.remove('opacity-100');
            lightbox.classList.add('opacity-0');
            
            setTimeout(() => {
                lightbox.classList.add('hidden');
                document.body.style.overflow = 'auto';
            }, 300);
        }

        function navigateLightbox(direction) {
            lightboxImg.style.transform = 'scale(0.95)';
            lightboxImg.style.opacity = '0.5';

            setTimeout(() => {
                if (direction === 'next') {
                    currentLightboxIndex = (currentLightboxIndex + 1) % filteredImages.length;
                } else if (direction === 'prev') {
                    currentLightboxIndex = (currentLightboxIndex - 1 + filteredImages.length) % filteredImages.length;
                }
                updateLightboxContent();
                
                lightboxImg.style.transform = 'scale(1)';
                lightboxImg.style.opacity = '1';
            }, 150);
        }

        function updateLightboxContent() {
            const currentImgData = filteredImages[currentLightboxIndex];
            lightboxImg.src = currentImgData.src;
            lightboxImg.alt = currentImgData.title;
            lightboxCaption.textContent = `${currentImgData.title} (${currentImgData.category})`;
        }

        function init() {
            renderGallery();

            filterButtons.forEach(btn => {
                btn.addEventListener('click', handleFilterClick);
            });

            btnClose.addEventListener('click', closeLightbox);
            btnNext.addEventListener('click', () => navigateLightbox('next'));
            btnPrev.addEventListener('click', () => navigateLightbox('prev'));

            lightbox.addEventListener('click', (e) => {
                if (e.target === lightbox || e.target.classList.contains('flex')) {
                    closeLightbox();
                }
            });

            document.addEventListener('keydown', (e) => {
                if (lightbox.classList.contains('hidden')) return;

                if (e.key === 'Escape') closeLightbox();
                if (e.key === 'ArrowRight') navigateLightbox('next');
                if (e.key === 'ArrowLeft') navigateLightbox('prev');
            });
        }

        init();
    </script>
</body>
</html>
